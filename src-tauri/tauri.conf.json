{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Meeting Workstation",
  "version": "0.9.1",
  "identifier": "com.rainbow.aimw",
  "build": {
    "frontendDist": "../dist/client",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev:client"
  },
  "app": {
    "windows": [
      {
        "title": "AI Meeting Workstation",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "http://127.0.0.1:8788/updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFERjc0MTBDREFCRTFENkEKUldScUhiN2FERUgzSGQ5QlBKRmtGNUd6bnNPNDFlYlpKNWxyZnZWekl4OFpybkpJdFVmdkQ4aEoK",
      "dangerousInsecureTransportProtocol": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "copyright": "",
    "shortDescription": "本地会议转写与纪要工作台",
    "externalBin": [],
    "resources": {
      "sidecar/node_modules": "node_modules",
      "sidecar/server": "server",
      "sidecar/node/bin/node": "node-bin",
      "sidecar/package.json": "package.json",
      "../dist/client": "client",
      "../config/hotwords": "config/hotwords"
    }
  }
}
